{
  "name": "@novastepstudios/novacore-engine-client",
  "version": "1.0.0",
  "description": "TypeScript ESM client for novacore-engine — install, launch, and real-time events.",
  "author": "NovaStepStudios",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsc",
    "build:watch": "tsc --watch",
    "type-check": "tsc --noEmit",
    "clean": "rm -rf dist"
  },
  "devDependencies": {
    "typescript": "^5.4.0"
  },
  "keywords": [
    "minecraft",
    "launcher",
    "novacore",
    "novastepstudios",
    "step-launcher",
    "websocket",
    "typescript",
    "esm"
  ],
  "engines": {
    "node": ">=18.0.0"
  },
  "dependencies": {
    "@types/node": "^25.6.0"
  }
}
